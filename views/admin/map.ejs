  // ─── SEARCH & AUTOCOMPLETE LOGIC ──────────────────────────────────────────
  const searchInput = document.getElementById('mapGlobalSearch');
  const searchDropdown = document.getElementById('mapSearchDropdown');
  const resultsList = document.getElementById('msResultsList');
  const resultsCount = document.getElementById('msHeaderCount');
  const clearBtn = document.getElementById('mapSearchClearBtn');
  let selectedSearchIndex = -1;
  let currentSearchResults = [];

  function highlightMatch(text, query) {
    if (!text) return '';
    if (!query) return escapeHtml(text);
    const escaped = escapeHtml(text);
    const qEsc = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(`(${qEsc})`, 'gi');
    return escaped.replace(regex, '<mark>$1</mark>');
  }

  function doMapSearch(query) {
    const q = (query || '').trim().toLowerCase();
    if (!q) {
      searchDropdown.classList.remove('active');
      clearBtn.style.display = 'none';
      currentSearchResults = [];
      selectedSearchIndex = -1;
      return;
    }

    clearBtn.style.display = 'block';

    const matchedCustomers = customers.filter(c => {
      return (
        String(c.name || '').toLowerCase().includes(q) ||
        String(c.pppoe_username || '').toLowerCase().includes(q) ||
        String(c.phone || '').toLowerCase().includes(q) ||
        String(c.genieacs_tag || '').toLowerCase().includes(q) ||
        String(c.address || '').toLowerCase().includes(q) ||
        String(c.area || '').toLowerCase().includes(q) ||
        String(c.package_name || '').toLowerCase().includes(q) ||
        String(c.odp_name || '').toLowerCase().includes(q)
      );
    });

    const matchedOdps = odps.filter(o => {
      return (
        String(o.name || '').toLowerCase().includes(q) ||
        String(o.description || '').toLowerCase().includes(q)
      );
    });

    currentSearchResults = [
      ...matchedCustomers.map(c => ({ type: 'customer', data: c })),
      ...matchedOdps.map(o => ({ type: 'odp', data: o }))
    ];

    selectedSearchIndex = -1;
    resultsCount.textContent = `${currentSearchResults.length} Ditemukan`;

    if (currentSearchResults.length === 0) {
      resultsList.innerHTML = `
        <div class="ms-empty">
          <i class="bi bi-search" style="font-size: 24px; color: #cbd5e1; display: block; margin-bottom: 6px;"></i>
          Tidak ditemukan data untuk "<strong>${escapeHtml(query)}</strong>"
        </div>
      `;
    } else {
      let html = '';
      currentSearchResults.slice(0, 30).forEach((item, index) => {
        if (item.type === 'customer') {
          const c = item.data;
          const isActive = c.status === 'active';
          const hasGps = Boolean(c.lat && c.lng);
          html += `
            <div class="ms-item" data-index="${index}" onclick="selectSearchResult(${index})">
              <div class="ms-item-icon ${isActive ? 'active' : 'suspended'}">
                <i class="bi bi-router-fill"></i>
              </div>
              <div class="ms-item-info">
                <div class="ms-item-name">
                  <span>${highlightMatch(c.name, query)}</span>
                  ${!hasGps ? '<span style="color:#ef4444; font-size:10px; font-weight:700;"><i class="bi bi-exclamation-triangle"></i> Tanpa GPS</span>' : ''}
                </div>
                <div class="ms-item-meta">
                  ${c.pppoe_username ? `<span>PPPoE: ${highlightMatch(c.pppoe_username, query)}</span> • ` : ''}
                  ${c.phone ? `<span>HP: ${highlightMatch(c.phone, query)}</span> • ` : ''}
                  ${c.odp_name ? `<span>ODP: ${highlightMatch(c.odp_name, query)}</span> • ` : ''}
                  <span>${escapeHtml(c.address || c.package_name || '-')}</span>
                </div>
              </div>
              <span class="ms-item-badge ${isActive ? 'ms-badge-active' : 'ms-badge-suspended'}">
                ${isActive ? 'Aktif' : 'Isolir'}
              </span>
            </div>
          `;
        } else {
          const o = item.data;
          html += `
            <div class="ms-item" data-index="${index}" onclick="selectSearchResult(${index})">
              <div class="ms-item-icon odp">
                <i class="bi bi-box-seam-fill"></i>
              </div>
              <div class="ms-item-info">
                <div class="ms-item-name">
                  <span>${highlightMatch(o.name, query)}</span>
                  <span style="font-size: 10px; color: #b45309; font-weight: 700;">(ODP Box)</span>
                </div>
                <div class="ms-item-meta">${highlightMatch(o.description || 'Titik Distribusi ODP', query)}</div>
              </div>
              <span class="ms-item-badge ms-badge-odp">ODP</span>
            </div>
          `;
        }
      });
      resultsList.innerHTML = html;
    }

    searchDropdown.classList.add('active');
  }

  function clearMapSearch() {
    searchInput.value = '';
    doMapSearch('');
    searchInput.focus();
  }

  function selectSearchResult(index) {
    if (!currentSearchResults[index]) return;
    const item = currentSearchResults[index];
    searchDropdown.classList.remove('active');

    if (item.type === 'customer') {
      focusCustomer(item.data.id);
    } else {
      focusOdp(item.data.id);
    }
  }

  // Keyboard navigation for search results
  searchInput.addEventListener('input', (e) => doMapSearch(e.target.value));
  searchInput.addEventListener('keydown', (e) => {
    if (!searchDropdown.classList.contains('active')) return;
    const items = resultsList.querySelectorAll('.ms-item');
    if (items.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedSearchIndex = (selectedSearchIndex + 1) % items.length;
      updateSearchSelection(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedSearchIndex = (selectedSearchIndex - 1 + items.length) % items.length;
      updateSearchSelection(items);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (selectedSearchIndex >= 0 && selectedSearchIndex < items.length) {
        selectSearchResult(selectedSearchIndex);
      } else if (items.length > 0) {
        selectSearchResult(0);
      }
    } else if (e.key === 'Escape') {
      searchDropdown.classList.remove('active');
    }
  });

  function updateSearchSelection(items) {
    items.forEach((it, idx) => {
      if (idx === selectedSearchIndex) {
        it.classList.add('selected');
        it.scrollIntoView({ block: 'nearest' });
      } else {
        it.classList.remove('selected');
      }
    });
  }

  // Global hotkey: Ctrl+K or / to search
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey && e.key.toLowerCase() === 'k') || (e.key === '/' && document.activeElement !== searchInput && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA')) {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    }
  });

  // Close search dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.map-search-box')) {
      searchDropdown.classList.remove('active');
    }
  });

  // ─── FOCUS ACTIONS ────────────────────────────────────────────────────────
  function focusCustomer(id) {
    const entry = customerMap[id];
    if (!entry) {
      const c = customers.find(x => x.id === id);
      if (c && (!c.lat || !c.lng)) {
        alert(`Pelanggan "${c.name}" belum memiliki koordinat GPS.`);
      }
      return;
    }

    const { marker, data } = entry;
    const lat = parseFloat(data.lat);
    const lng = parseFloat(data.lng);

    map.flyTo([lat, lng], 18, { duration: 1 });

    setTimeout(() => {
      marker.openPopup();
      const node = document.getElementById(`onu-node-${id}`);
      if (node) {
        node.classList.add('marker-pulse-highlight');
        setTimeout(() => node.classList.remove('marker-pulse-highlight'), 2500);
      }
    }, 800);
  }

  function focusOdp(id) {
    const entry = odpMap[id];
    if (!entry) return;

    const { marker, coord } = entry;
    map.flyTo(coord, 18, { duration: 1 });

    setTimeout(() => {
      marker.openPopup();
      const node = document.getElementById(`odp-node-${id}`);
      if (node) {
        node.classList.add('marker-pulse-highlight');
        setTimeout(() => node.classList.remove('marker-pulse-highlight'), 2500);
      }
    }, 800);
  }

  function editOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    const odpId = Number(btn.dataset.odpId);
    const found = odps.find(o => Number(o.id) === odpId);
    if (found) editOdp(found);
  }

  function deleteOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    const odpId = btn.dataset.odpId;
    if (confirm('Apakah Anda yakin ingin menghapus ODP ini?')) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = `/admin/odps/${odpId}/delete`;
      document.body.appendChild(form);
      form.submit();
    }
  }

  function focusOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    focusOdp(btn.dataset.odpId);
  }

  // ─── FILTER & TOGGLE ACTIONS ──────────────────────────────────────────────
  function applyStatusFilter(status) {
    currentFilter = status;
    document.querySelectorAll('.map-filter-group .map-pill-btn').forEach(b => {
      if (b.id === 'pillAll' && status === 'all') b.classList.add('active');
      else if (b.id === 'pillActive' && status === 'active') b.classList.add('active');
      else if (b.id === 'pillSuspended' && status === 'suspended') b.classList.add('active');
      else if (b.id.startsWith('pill') && b.id !== 'pillLabels') b.classList.remove('active');
    });

    Object.keys(customerMap).forEach(id => {
      const { marker, data, polyline } = customerMap[id];
      const isActive = data.status === 'active';
      let shouldShow = true;

      if (status === 'active' && !isActive) shouldShow = false;
      if (status === 'suspended' && isActive) shouldShow = false;

      if (shouldShow) {
        if (!map.hasLayer(marker)) map.addLayer(marker);
        if (polyline && !map.hasLayer(polyline)) map.addLayer(polyline);
      } else {
        if (map.hasLayer(marker)) map.removeLayer(marker);
        if (polyline && map.hasLayer(polyline)) map.removeLayer(polyline);
      }
    });
  }

  function toggleMarkerLabels() {
    showLabels = !showLabels;
    const btn = document.getElementById('pillLabels');
    const txt = document.getElementById('labelToggleText');
    const mapEl = document.getElementById('map');

    if (showLabels) {
      mapEl.classList.remove('hide-marker-labels');
      btn.classList.add('active');
      txt.textContent = 'Label: ON';
    } else {
      mapEl.classList.add('hide-marker-labels');
      btn.classList.remove('active');
      txt.textContent = 'Label: OFF';
    }
  }

  function fitAllMarkers() {
    const allLayers = [];
    Object.values(customerMap).forEach(e => {
      if (map.hasLayer(e.marker)) allLayers.push(e.marker);
    });
    Object.values(odpMap).forEach(e => {
      if (map.hasLayer(e.marker)) allLayers.push(e.marker);
    });

    if (allLayers.length > 0) {
      const group = L.featureGroup(allLayers);
      map.fitBounds(group.getBounds().pad(0.1));
    } else {
      map.setView([officeCoords.lat, officeCoords.lng], 13);
    }
  }

  // ─── TABBED DATA PANEL LOGIC ──────────────────────────────────────────────
  function switchDataTab(tabId, btn) {
    document.querySelectorAll('.data-tabs-panel .tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.data-tabs-panel .tab-btn').forEach(el => el.classList.remove('active'));
    
    const target = document.getElementById(tabId);
    if (target) target.classList.add('active');
    if (btn) btn.classList.add('active');
  }

  // Filter Customer Table
  const custTableSearch = document.getElementById('customerTableSearch');
  const custGpsFilter = document.getElementById('customerGpsFilter');
  const custTbody = document.getElementById('customersTableBody');

  function filterCustomerTable() {
    if (!custTbody) return;
    const q = (custTableSearch.value || '').trim().toLowerCase();
    const gpsFilter = custGpsFilter ? custGpsFilter.value : 'all';
    const rows = custTbody.querySelectorAll('tr[data-id]');

    rows.forEach(r => {
      const name = r.getAttribute('data-name') || '';
      const pppoe = r.getAttribute('data-pppoe') || '';
      const phone = r.getAttribute('data-phone') || '';
      const tag = r.getAttribute('data-tag') || '';
      const address = r.getAttribute('data-address') || '';
      const status = r.getAttribute('data-status') || '';
      const hasGps = r.getAttribute('data-hasgps') === '1';

      const matchText = !q || name.includes(q) || pppoe.includes(q) || phone.includes(q) || tag.includes(q) || address.includes(q);
      
      let matchGps = true;
      if (gpsFilter === 'has_gps') matchGps = hasGps;
      else if (gpsFilter === 'no_gps') matchGps = !hasGps;
      else if (gpsFilter === 'active') matchGps = (status === 'active');
      else if (gpsFilter === 'suspended') matchGps = (status !== 'active');

      r.style.display = (matchText && matchGps) ? '' : 'none';
    });
  }

  if (custTableSearch) {
    custTableSearch.addEventListener('input', filterCustomerTable);
  }

  // Filter ODP Table
  (function bindOdpSearch() {
    const input = document.getElementById('odpSearch');
    const tbody = document.getElementById('odpsTbody');
    if (!input || !tbody) return;

    function apply() {
      const q = String(input.value || '').trim().toLowerCase();
      const rows = Array.from(tbody.querySelectorAll('tr[data-name]'));
      rows.forEach(r => {
        const name = String(r.getAttribute('data-name') || '');
        const desc = String(r.getAttribute('data-desc') || '');
        r.style.display = !q || name.includes(q) || desc.includes(q) ? '' : 'none';
      });
    }

    input.addEventListener('input', apply);
    apply();
  })();

  // ─── CABLE DRAWING & MODALS ────────────────────────────────────────────────
  let drawingMap, drawingPolyline, drawingMarkers = [];
  
  function interpolatePoints(p1, p2, count) {
    const points = [p1];
    for (let i = 1; i <= count; i++) {
      const lat = p1[0] + (p2[0] - p1[0]) * (i / (count + 1));
      const lng = p1[1] + (p2[1] - p1[1]) * (i / (count + 1));
      points.push([lat, lng]);
    }
    points.push(p2);
    return points;
  }

  function renderEditorMarkers() {
    drawingMarkers.forEach(m => drawingMap.removeLayer(m));
    drawingMarkers = [];

    const latlngs = drawingPolyline.getLatLngs();
    latlngs.forEach((ll, index) => {
      const isEdge = index === 0 || index === latlngs.length - 1;
      const marker = L.marker(ll, {
        draggable: true,
        zIndexOffset: 2000,
        icon: L.divIcon({
          html: `<div style="background: ${isEdge ? '#3b82f6' : '#ef4444'}; width: 16px; height: 16px; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 5px rgba(0,0,0,0.5);"></div>`,
          className: 'custom-div-icon',
          iconSize: [16, 16],
          iconAnchor: [8, 8]
        })
      }).addTo(drawingMap);

      marker.on('drag', (e) => {
        const newLatLngs = drawingPolyline.getLatLngs();
        newLatLngs[index] = e.latlng;
        drawingPolyline.setLatLngs(newLatLngs);
      });

      drawingMarkers.push(marker);
    });
  }

  function startCableDrawing(customerId, lat, lng, odpId) {
    const odp = odpMap[odpId];
    if (!odp) return alert('Data ODP tidak ditemukan atau belum dipilih');

    currentEditingCustomer = customerId;
    openModal('cablePathModal');

    setTimeout(() => {
      try {
        if (drawingMap) drawingMap.remove();
        
        drawingMap = L.map('cable-drawing-map').setView([lat, lng], 17);
        L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
          maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
        }).addTo(drawingMap);

        const customer = customers.find(c => c.id === customerId);
        let pathCoords = [];
        if (customer && customer.cable_path) {
          try { pathCoords = JSON.parse(customer.cable_path); } catch(e) {}
        }
        
        if (pathCoords.length <= 2) {
          pathCoords = interpolatePoints([parseFloat(lat), parseFloat(lng)], odp.coord, 5);
        }

        drawingPolyline = L.polyline(pathCoords, {
          color: '#f59e0b', weight: 6, dashArray: '5, 5', interactive: false
        }).addTo(drawingMap);

        renderEditorMarkers();

        setTimeout(() => {
          drawingMap.invalidateSize();
          drawingMap.fitBounds(drawingPolyline.getBounds(), { padding: [50, 50] });
        }, 200);
      } catch (err) {
        console.error("Drawing map error:", err);
      }
    }, 600);
  }

  function addMorePoints() {
    if (!drawingPolyline || !drawingMap) return;
    const latlngs = drawingPolyline.getLatLngs();
    const newPath = [];
    for (let i = 0; i < latlngs.length - 1; i++) {
      newPath.push(latlngs[i]);
      const midLat = (latlngs[i].lat + latlngs[i+1].lat) / 2;
      const midLng = (latlngs[i].lng + latlngs[i+1].lng) / 2;
      newPath.push(L.latLng(midLat, midLng));
    }
    newPath.push(latlngs[latlngs.length - 1]);
    drawingPolyline.setLatLngs(newPath);
    renderEditorMarkers();
  }

  async function saveCablePath() {
    if (!drawingPolyline || !currentEditingCustomer) return;
    const latlngs = drawingPolyline.getLatLngs().map(ll => [ll.lat, ll.lng]);
    const pathJson = JSON.stringify(latlngs);

    try {
      const res = await fetch(`/admin/api/customers/${currentEditingCustomer}/cable-path`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ path: pathJson })
      });
      
      const contentType = res.headers.get("content-type");
      if (contentType && contentType.indexOf("application/json") !== -1) {
        const data = await res.json();
        if (data.ok) {
          alert('Jalur kabel berhasil disimpan!');
          location.reload();
        } else {
          alert('Gagal menyimpan: ' + data.error);
        }
      } else {
        alert('Gagal menyimpan jalur kabel.');
      }
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }

  // ODP Modal Pickers
  let pickerMap, pickerMarker;
  let editPickerMap, editPickerMarker;

  function initPickerMap(lat, lng) {
    if (!pickerMap) {
      pickerMap = L.map('picker-map').setView([lat, lng], 16);
      L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
      }).addTo(pickerMap);
      
      const odpIcon = L.divIcon({
        html: '<i class="bi bi-box-seam-fill picker-icon-odp"></i>',
        className: 'custom-div-icon',
        iconSize: [24, 24],
        iconAnchor: [12, 12]
      });

      pickerMarker = L.marker([lat, lng], { draggable: true, icon: odpIcon }).addTo(pickerMap);
      
      pickerMarker.on('dragend', function(e) {
        const pos = pickerMarker.getLatLng();
        document.getElementById('new_lat').value = pos.lat.toFixed(6);
        document.getElementById('new_lng').value = pos.lng.toFixed(6);
      });

      pickerMap.on('click', function(e) {
        pickerMarker.setLatLng(e.latlng);
        document.getElementById('new_lat').value = e.latlng.lat.toFixed(6);
        document.getElementById('new_lng').value = e.latlng.lng.toFixed(6);
      });
    } else {
      pickerMap.setView([lat, lng], 16);
      pickerMarker.setLatLng([lat, lng]);
    }
    setTimeout(() => pickerMap.invalidateSize(), 300);
  }

  function initEditPickerMap(lat, lng) {
    if (!editPickerMap) {
      editPickerMap = L.map('edit-picker-map').setView([lat, lng], 16);
      L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
      }).addTo(editPickerMap);
      
      const odpIcon = L.divIcon({
        html: '<i class="bi bi-box-seam-fill picker-icon-odp"></i>',
        className: 'custom-div-icon',
        iconSize: [24, 24],
        iconAnchor: [12, 12]
      });

      editPickerMarker = L.marker([lat, lng], { draggable: true, icon: odpIcon }).addTo(editPickerMap);
      
